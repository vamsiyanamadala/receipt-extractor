# Required: get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model. Defaults to claude-sonnet-4-6 (recommended for vision).
# Alternatives:
#   claude-opus-4-7    — higher accuracy, ~5x cost, slightly higher latency
#   claude-haiku-4-5   — cheaper / faster, slightly lower extraction accuracy
# ANTHROPIC_MODEL=claude-sonnet-4-6
